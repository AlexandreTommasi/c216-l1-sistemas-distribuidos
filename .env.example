# Credenciais do Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=overload

# DATABASE_URL usa "db" como host — nome do servico dentro da rede do Compose
DATABASE_URL=postgresql://postgres:postgres@db:5432/overload

# CORS — lista separada por virgula (origem do frontend vista pelo browser)
CORS_ORIGINS=http://localhost:5173

# Portas publicadas no host
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Base da API embutida no bundle do frontend em tempo de build
# Deve ser o endereco do backend visto pelo browser (host), nao pelo Compose
VITE_API_URL=http://localhost:8000
