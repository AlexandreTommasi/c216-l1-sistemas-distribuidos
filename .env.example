# Banco de dados (psycopg 3 — use postgresql:// ou postgresql+psycopg://)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/overload

# Postgres (usado pelo docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=overload
POSTGRES_PORT=5432

# CORS — lista separada por vírgula
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Portas da aplicação
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Variável consumida pelo Vite no frontend
VITE_API_URL=http://localhost:8000
